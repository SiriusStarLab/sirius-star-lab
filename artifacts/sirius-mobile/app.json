{
  "expo": {
    "name": "Sirius AI",
    "slug": "sirius-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sirius-mobile",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080c1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.siriusai.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      }
    },
    "android": {
      "backgroundColor": "#080c1a",
      "package": "com.siriusai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080c1a"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "privacyPolicyUrl": "https://ai-companion-huttongarry4.replit.app/privacy",
      "termsUrl": "https://ai-companion-huttongarry4.replit.app/terms",
      "eas": {
        "projectId": "44095ebc-6e60-4f8a-8b90-d2b2bc85588b"
      }
    },
    "owner": "garryboy"
  }
}
