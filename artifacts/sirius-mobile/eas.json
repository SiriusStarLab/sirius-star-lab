{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "garryboy@icloud.com",
        "ascAppId": "REPLACE_WITH_NUMERIC_APP_ID_FROM_APP_STORE_CONNECT",
        "appleTeamId": "REPLACE_WITH_10_CHAR_TEAM_ID_FROM_DEVELOPER_APPLE_COM",
        "language": "en-GB",
        "sku": "com.siriusai.app",
        "metadataPath": "./store-metadata/ios"
      },
      "android": {
        "serviceAccountKeyPath": "./store-metadata/google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
